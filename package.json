{
  "name": "smart-fire-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:backend\"",
    "dev:web": "next dev --webpack",
    "dev:backend": "tsx watch apps/backend/src/server.ts",
    "build": "next build",
    "build:backend": "tsc -p apps/backend/tsconfig.json",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "test": "npm run test:backend",
    "test:backend": "npm run build:backend && node tests/backend/run-backend-tests.js",
    "test:web": "node tests/web/run-web-smoke.js",
    "pressure:ingestion": "node scripts/pressure/ingestion-pressure.js"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
